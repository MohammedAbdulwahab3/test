# Server
PORT=8080
AUTO_MIGRATE=true

# CORS - comma-separated list of allowed origins (use * for all)
CORS_ORIGINS=*

# Database: sqlite or postgres
DB_DRIVER=sqlite
# For sqlite
SQLITE_PATH=data.db
# OR specify DSN directly
# DB_DSN=file:data.db?cache=shared&_fk=1&_journal_mode=WAL&_busy_timeout=10000

# For postgres
# DB_DRIVER=postgres
# DB_DSN=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
